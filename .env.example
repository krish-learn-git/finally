# Required: Anthropic API key for LLM chat functionality
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Enable real market data via Yahoo Finance (free, no API key needed)
YFINANCE_ENABLED=false

# Optional: Set to "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false

# Optional: SQLite database path (default: /app/db/finally.db inside Docker)
DB_PATH=/app/db/finally.db
